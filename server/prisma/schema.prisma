generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model airports {
  id                                               Int       @id @default(autoincrement())
  abbreviation                                     String?
  full_name                                        String?
  city                                             String?
  flights_flights_destination_airport_idToairports flights[] @relation("flights_destination_airport_idToairports")
  flights_flights_origin_airport_idToairports      flights[] @relation("flights_origin_airport_idToairports")
}

model atm_transactions {
  id               Int     @id @default(autoincrement())
  account_number   Int?
  year             Int?
  month            Int?
  day              Int?
  atm_location     String?
  transaction_type String?
  amount           Int?
}

model bakery_security_logs {
  id            Int     @id @default(autoincrement())
  year          Int?
  month         Int?
  day           Int?
  hour          Int?
  minute        Int?
  activity      String?
  license_plate String?
}

model bank_accounts {
  account_number Int     @id
  person_id      Int?
  creation_year  Int?
  people         people? @relation(fields: [person_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model crime_scene_reports {
  id          Int     @id @default(autoincrement())
  year        Int?
  month       Int?
  day         Int?
  street      String?
  description String?
}

model flights {
  id                                                Int          @id @default(autoincrement())
  origin_airport_id                                 Int?
  destination_airport_id                            Int?
  year                                              Int?
  month                                             Int?
  day                                               Int?
  hour                                              Int?
  minute                                            Int?
  airports_flights_destination_airport_idToairports airports?    @relation("flights_destination_airport_idToairports", fields: [destination_airport_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  airports_flights_origin_airport_idToairports      airports?    @relation("flights_origin_airport_idToairports", fields: [origin_airport_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  passengers                                        passengers[] @ignore
}

model interviews {
  id         Int     @id @default(autoincrement())
  name       String?
  year       Int?
  month      Int?
  day        Int?
  transcript String?
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model passengers {
  flight_id       Int?
  passport_number Int?
  seat            String?
  flights         flights? @relation(fields: [flight_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@ignore
}

model people {
  id              Int             @id @default(autoincrement())
  name            String?
  phone_number    String?
  passport_number Int?
  license_plate   String?
  bank_accounts   bank_accounts[]
}

model phone_calls {
  id       Int     @id @default(autoincrement())
  caller   String?
  receiver String?
  year     Int?
  month    Int?
  day      Int?
  duration Int?
}
